{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ailyricvideomaker",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "vars": {
    "LYRIC_VIDEO_TRANSCRIPTION_PROVIDER": "development-stub",
    "LYRIC_VIDEO_MAX_AUDIO_BYTES": "26214400",
    "LYRIC_VIDEO_DAILY_TRANSCRIPTION_LIMIT": "5",
    "LYRIC_VIDEO_MAX_DURATION_SECONDS": "300"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ailyricvideomaker",
      "database_id": "9a3741cb-70aa-490f-898c-c2bc84466a79",
      "remote": false, //本地开发时，不连接 Cloudflare 上真实的 D1，而是使用本地模拟/本地存储的 D1//
      "migrations_dir": "../../packages/data-ops/src/drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "LYRIC_VIDEO_BUCKET",  //Worker 运行时暴露给代码使用的变量名，整个程序在使用R2存储桶是用的变量名，不做修改//
      "bucket_name": "ailyricvideomaker",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "LYRIC_VIDEO_JOBS",
        "queue": "lyric-video-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "lyric-video-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
      },
    ],
  },
  "env": {
    "staging": {
      "name": "ailyricvideomaker-staging",
      "vars": {
        "LYRIC_VIDEO_TRANSCRIPTION_PROVIDER": "development-stub",
        "LYRIC_VIDEO_MAX_AUDIO_BYTES": "26214400",
        "LYRIC_VIDEO_DAILY_TRANSCRIPTION_LIMIT": "5",
        "LYRIC_VIDEO_MAX_DURATION_SECONDS": "300"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ailyricvideomaker-staging",
          "database_id": "ceea7c1f-3ae6-402b-8c80-5f27ec3fb5fe",
          "migrations_dir": "../../packages/data-ops/src/drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "LYRIC_VIDEO_BUCKET",
          "bucket_name": "ailyricvideomaker-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "LYRIC_VIDEO_JOBS",
            "queue": "lyric-video-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "lyric-video-jobs-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 2
          }
        ]
      }
    }
  }
}
